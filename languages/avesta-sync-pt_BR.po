#. Plugin Name of the plugin
#: avesta-sync.php
#: includes/class-admin.php:33
#: includes/class-admin.php:156
#: includes/views/i18n.php:127
msgid "Avesta Sync"
msgstr "Avesta Sync"

#. Plugin URI of the plugin
#: avesta-sync.php
msgid "https://avestatech.ir"
msgstr "https://avestatech.ir"

#. Description of the plugin
#: avesta-sync.php
msgid "Hash-based two-way sync (push/pull) of theme files, custom plugins, content, media and WooCommerce catalog and settings between a local site and production over a signed REST API. Only changed items are transferred."
msgstr "Sincronização bidirecional (enviar/receber) baseada em hash de arquivos de tema, plugins personalizados, conteúdo, mídia e catálogo e configurações do WooCommerce entre um site local e a produção, por meio de uma API REST assinada. Apenas os itens alterados são transferidos."

#. Author of the plugin
#: avesta-sync.php
msgid "AvestaTech"
msgstr "AvestaTech"

