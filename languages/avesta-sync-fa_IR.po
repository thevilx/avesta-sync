#. Plugin Name of the plugin
#: avesta-sync.php includes/class-admin.php:33 includes/class-admin.php:156
#: includes/views/i18n.php:127
msgid "Avesta Sync"
msgstr "Avesta Sync"

#. Plugin URI of the plugin
#: avesta-sync.php
msgid "https://avestatech.ir"
msgstr "https://avestatech.ir"

#. Description of the plugin
#: avesta-sync.php
msgid ""
"Hash-based two-way sync (push/pull) of theme files, custom plugins, content, "
"media and WooCommerce catalog and settings between a local site and "
"production over a signed REST API. Only changed items are transferred."
msgstr "همگام‌سازی دوطرفهٔ مبتنی بر هش (ارسال/دریافت) پرونده‌های پوسته، افزونه‌های سفارشی، محتوا، رسانه و کاتالوگ و تنظیمات ووکامرس میان سایت محلی و سایت اصلی از طریق REST API امضاشده. فقط موارد تغییریافته منتقل می‌شوند."

#. Author of the plugin
#: avesta-sync.php
msgid "AvestaTech"
msgstr "AvestaTech"

