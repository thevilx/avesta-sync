#: includes/class-admin.php:156
#: includes/views/i18n.php:127
msgid "Avesta Sync"
msgstr "Avesta Sync"

#. Plugin URI of the plugin
#: avesta-sync.php
msgid "https://avestatech.ir"
msgstr "https://avestatech.ir"

#. Description of the plugin
#: avesta-sync.php
msgid "Hash-based two-way sync (push/pull) of theme files, custom plugins, content, media and WooCommerce catalog and settings between a local site and production over a signed REST API. Only changed items are transferred."
msgstr "Sincronizzazione bidirezionale (push/pull) basata su hash di file del tema, plugin personalizzati, contenuti, media e catalogo e impostazioni di WooCommerce tra un sito locale e il sito di produzione tramite un'API REST firmata. Vengono trasferiti solo gli elementi modificati."

#. Author of the plugin
#: avesta-sync.php
msgid "AvestaTech"
msgstr "AvestaTech"

