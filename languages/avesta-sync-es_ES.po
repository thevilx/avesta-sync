#: includes/class-admin.php:33
#: includes/class-admin.php:156
#: includes/views/i18n.php:127
msgid "Avesta Sync"
msgstr "Avesta Sync"

#. Plugin URI of the plugin
#: avesta-sync.php
msgid "https://avestatech.ir"
msgstr "https://avestatech.ir"

#. Description of the plugin
#: avesta-sync.php
msgid "Hash-based two-way sync (push/pull) of theme files, custom plugins, content, media and WooCommerce catalog and settings between a local site and production over a signed REST API. Only changed items are transferred."
msgstr "Sincronización bidireccional (enviar/traer) basada en hashes de archivos de tema, plugins propios, contenido, medios y catálogo y ajustes de WooCommerce entre un sitio local y producción mediante una API REST firmada. Solo se transfieren los elementos modificados."

#. Author of the plugin
#: avesta-sync.php
msgid "AvestaTech"
msgstr "AvestaTech"

