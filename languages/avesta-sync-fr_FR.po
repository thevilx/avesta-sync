#. Plugin Name of the plugin
#: avesta-sync.php
#: includes/class-admin.php:33
#: includes/class-admin.php:156
#: includes/views/i18n.php:127
msgid "Avesta Sync"
msgstr "Avesta Sync"

#. Plugin URI of the plugin
#: avesta-sync.php
msgid "https://avestatech.ir"
msgstr "https://avestatech.ir"

#. Description of the plugin
#: avesta-sync.php
msgid "Hash-based two-way sync (push/pull) of theme files, custom plugins, content, media and WooCommerce catalog and settings between a local site and production over a signed REST API. Only changed items are transferred."
msgstr "Synchronisation bidirectionnelle (envoi/récupération) basée sur des empreintes des fichiers de thème, des extensions personnalisées, du contenu, des médias ainsi que du catalogue et des réglages WooCommerce entre un site local et la production, via une API REST signée. Seuls les éléments modifiés sont transférés."

#. Author of the plugin
#: avesta-sync.php
msgid "AvestaTech"
msgstr "AvestaTech"

