#. Plugin Name of the plugin
#: avesta-sync.php
#: includes/class-admin.php:33
#: includes/class-admin.php:156
#: includes/views/i18n.php:127
msgid "Avesta Sync"
msgstr "Avesta Sync"

#. Plugin URI of the plugin
#: avesta-sync.php
msgid "https://avestatech.ir"
msgstr "https://avestatech.ir"

#. Description of the plugin
#: avesta-sync.php
msgid "Hash-based two-way sync (push/pull) of theme files, custom plugins, content, media and WooCommerce catalog and settings between a local site and production over a signed REST API. Only changed items are transferred."
msgstr "Двусторонняя синхронизация (отправка/получение) файлов темы, собственных плагинов, контента, медиафайлов, а также каталога и настроек WooCommerce между локальным сайтом и рабочим сайтом через подписанный REST API на основе хешей. Передаются только изменённые элементы."

#. Author of the plugin
#: avesta-sync.php
msgid "AvestaTech"
msgstr "AvestaTech"

